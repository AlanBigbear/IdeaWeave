APP_NAME=B-Star
DEBUG=true
JWT_SECRET=change-me-in-local-demo-please-use-32bytes+
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# ngrok 域名已在代码里用正则放行（https://*.ngrok-free.dev）；同源托管时也可不依赖 CORS
DATA_DIR=./data

# Defaults used when a user has not saved their own settings. API Key stays in .env, not git.
DEFAULT_LLM_BASE_URL=https://api.deepseek.com/v1
DEFAULT_LLM_MODEL=deepseek-v4-pro
DEFAULT_LLM_FAST_MODEL=deepseek-v4-flash
DEFAULT_LLM_API_KEY=

# Shared no-registration trial workspace. Three selectable accounts (tech/anime/pet).
# They reset on startup and at this interval. Users choose an account; keys are stable.
TRIAL_ENABLED=true
TRIAL_USERNAME=demo
TRIAL_ANIME_USERNAME=demo-anime
TRIAL_PET_USERNAME=demo-pet
TRIAL_RESET_MINUTES=60
TRIAL_JWT_EXPIRE_MINUTES=120
TRIAL_LOGIN_REQUESTS_PER_MINUTE=20
TRIAL_GENERATION_REQUESTS_PER_WINDOW=5
TRIAL_GENERATION_WINDOW_SECONDS=600
TRIAL_GENERATION_MAX_CONCURRENCY=2

# MySQL. Leave empty to use local SQLite at DATA_DIR/bstar.db
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/ideaweave?charset=utf8mb4
MYSQL_CONNECT_TIMEOUT=5
MYSQL_FALLBACK_SQLITE=true
